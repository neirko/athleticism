<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variants, picked by Android when the phone is in dark mode.
         Without these the app opened on a full-screen cream splash, then a
         white window, before the dark app painted. The web page cannot reach
         this far: it has not loaded yet. Colour matches the dark theme background. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/athleticism_night_bg</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/athleticism_night_bg</item>
        <item name="windowSplashScreenBackground">@color/athleticism_night_bg</item>
    </style>

    <color name="athleticism_night_bg">#141118</color>
</resources>
